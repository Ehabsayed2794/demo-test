<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- The instrumented suite is the only :services code that opens sockets,
       and this manifest is never merged into a shipped AAR — only into the
       androidTest APK. -->
  <uses-permission android:name="android.permission.INTERNET" />

  <!-- Lifts the targetSdk-28+ cleartext block for the emulator host only;
       see res/xml/network_security_config.xml. Without this the suite dies
       at setup with "Cleartext HTTP traffic to 10.0.2.2 not permitted". -->
  <application android:networkSecurityConfig="@xml/network_security_config" />

</manifest>
