  <!-- S16 — the Room/waiting screen: the code to share, the roster, ready-up. -->
  <string name="room_title">Room</string>
  <!-- The shareable code, read aloud or copied by hand; %1$s is the code. -->
  <string name="room_code">Room code: %1$s</string>
  <string name="room_section_players">Players</string>
  <!-- A seat that is ready to start. -->
  <string name="room_ready">Ready</string>
  <!-- A seat that has not readied up yet. -->
  <string name="room_not_ready">Not ready</string>
  <!-- The seat the local player occupies. -->
  <string name="room_you">You</string>
  <!-- The seat that owns the room and may start the match. -->
  <string name="room_host">Host</string>
  <!--
    The local player's own ready toggle. For the host this IS the start
    button: RoomService starts the match the moment every seat is ready and
    the acting uid is the creator, so the label stays one action.
  -->
  <string name="room_toggle_ready">Ready up</string>
  <string name="room_toggle_not_ready">Cancel ready</string>
  <string name="room_waiting_hint">Waiting for everyone to be ready…</string>
  <!-- Shown when every seat is ready and the host's start has been attempted. -->
  <string name="room_starting">Starting the match…</string>
  <string name="room_leave">Leave room</string>
  <!-- The room vanished (last player out closed it) or the first load failed. -->
  <string name="room_gone">This room is no longer available.</string>

  <!-- S17 — the online match flow. -->
  <!--
    The fail-open overlay: shown over a live screen while the listener is
    retrying. The local game keeps what it has, so this never blocks play.
  -->
  <string name="online_reconnecting">Reconnecting…</string>
  <string name="online_reconnecting_body">You\'re still in the match.</string>
  <!-- The signed-in player holds no seat here, or the match was deleted. -->
  <string name="online_not_in_match">You\'re no longer in this match.</string>
  <string name="online_failed_title">Couldn\'t keep this match in sync.</string>
  <!-- Action: leave the online match and go back to the lobby. -->
  <string name="online_leave_match">Back to lobby</string>
  <!--
    Shown under a scored round while the document advances to the next one;
    every seat advances the match, so this is a short wait, not a dead button.
  -->
  <string name="online_round_opening">Waiting for the next round…</string>
  <!--
    S19's passive staleness hint: an opponent holds the turn and the match
    document has not moved in a while. Deliberately "appears away" — the
    frozen rules make true presence impossible (players/{uid} is
    owner-read-only, list: false), so nothing stronger is ever claimed and
    there is no online indicator anywhere in the app. EN only; AR is deferred
    to S41 with the rest of the online strings.
  -->
  <string name="online_opponent_away">Opponent appears away</string>

  <!--
    S73 (RD19)'s banner for the player whose seat the configured bot is
    borrowing. Persistent, non-blocking, and never an accusation: inactivity
    is not network loss, and no error colour is used. It names the two things
    the roadmap requires the returning player to see — which seat is
    bot-controlled, and that return is possible — because the reclaim is
    automatic and there is no "I'm back" screen. EN only; AR is deferred to
    S41 with the rest of the online strings.
  -->
  <string name="online_seat_borrowed">The bot is playing your seat while you\'re away. It hands the seat back as soon as the trick finishes.</string>

