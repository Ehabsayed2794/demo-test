<?xml version="1.0" encoding="utf-8"?>
<!--
  Native v1's structural string resources (S12 lobby entries + S15 Real
  Lobby + S16 Room). Every other screen still holds literals inline; this
  file is where a screen's structural text lives so a values-ar/ sibling
  can later be dropped in to translate the whole app without touching
  Kotlin (S41). Tier and personality labels are deliberately absent here —
  they come from the engine enums' own displayName / blurb, so a
  translation of the characters lands with the engine, not duplicated in
  resources.
-->
<resources>
  <string name="choose_level_title">Choose Level</string>
  <string name="choose_level_subtitle">Seat your opponents, then sit down.</string>
  <string name="choose_level_presets">Preset tables</string>
  <string name="choose_level_opponents">Opponents</string>
  <string name="choose_level_skill">Skill</string>
  <string name="choose_level_style">Style</string>
  <string name="choose_level_custom">Custom</string>
  <string name="choose_level_start">Start match</string>
  <!-- The number of the chair, 1-based: "Seat 2", "Seat 3", "Seat 4". -->
  <string name="choose_level_seat">Seat %1$d</string>

  <!-- The lobby entry that opens the Choose Level screen — the app's AI path. -->
  <string name="lobby_play_vs_ai">Play vs AI</string>

  <!-- S15 — the Real Lobby: offline entries, invite-by-code rooms, account. -->
  <string name="lobby_title">Lobby</string>
  <!-- Shown under the title; %1$s is the Firebase uid of the signed-in player. -->
  <string name="lobby_signed_in_as">Signed in as %1$s</string>
  <string name="lobby_section_play">Offline</string>
  <string name="lobby_quick_match">Quick Match (offline)</string>
  <string name="lobby_section_rooms">Rooms</string>
  <!-- Action: make a new private room whose code the host shares by hand. -->
  <string name="lobby_create_room">Create Room</string>
  <string name="lobby_create_room_hint">Make a private room and share its code.</string>
  <!-- Action: join a room a friend has given you the code for. -->
  <string name="lobby_join_room">Join Room</string>
  <string name="lobby_join_room_hint">Enter a code a friend gave you.</string>
  <!-- Shown when the player is seated at a room; %1$s is the room code. -->
  <string name="lobby_in_room">In room %1$s</string>
  <string name="lobby_leave_room">Leave room</string>

  <!-- The join-by-code dialog (native; spec 01-screens.md forbids prompt()). -->
  <string name="lobby_join_dialog_title">Join a room</string>
  <string name="lobby_join_dialog_hint">Room code</string>
  <string name="lobby_join_dialog_join">Join</string>
  <string name="lobby_cancel">Cancel</string>
  <!-- The four ways a join is refused, mapped off ServiceException.reason. -->
  <string name="lobby_join_error_empty">Enter a room code.</string>
  <string name="lobby_join_error_not_found">No room with that code.</string>
  <string name="lobby_join_error_full">That room is full.</string>
  <string name="lobby_join_error_closed">That room is closed.</string>
  <string name="lobby_join_error_generic">Couldn\'t join that room. Try again.</string>

  <!-- The dialog shown once after creating, so the host can read the code out. -->
  <string name="lobby_created_title">Room created</string>
  <string name="lobby_created_body">Share this code with your friends:</string>
  <string name="lobby_created_done">Done</string>

  <string name="lobby_profile">Profile</string>
  <string name="lobby_settings">Settings</string>
  <string name="lobby_sign_out">Sign out</string>

  <!-- S16 — the Room/waiting screen: the code to share, the roster, ready-up. -->
  <string name="room_title">Room</string>
  <!-- The shareable code, read aloud or copied by hand; %1$s is the code. -->
  <string name="room_code">Room code: %1$s</string>
  <string name="room_section_players">Players</string>
  <!-- A seat that is ready to start. -->
  <string name="room_ready">Ready</string>
  <!-- A seat that has not readied up yet. -->
  <string name="room_not_ready">Not ready</string>
  <!-- The seat the local player occupies. -->
  <string name="room_you">You</string>
  <!-- The seat that owns the room and may start the match. -->
  <string name="room_host">Host</string>
  <!--
    The local player's own ready toggle. For the host this IS the start
    button: RoomService starts the match the moment every seat is ready and
    the acting uid is the creator, so the label stays one action.
  -->
  <string name="room_toggle_ready">Ready up</string>
  <string name="room_toggle_not_ready">Cancel ready</string>
  <string name="room_waiting_hint">Waiting for everyone to be ready…</string>
  <!-- Shown when every seat is ready and the host's start has been attempted. -->
  <string name="room_starting">Starting the match…</string>
  <string name="room_leave">Leave room</string>
  <!-- The room vanished (last player out closed it) or the first load failed. -->
  <string name="room_gone">This room is no longer available.</string>
</resources>
