  <string name="lobby_join_room">Join Room</string>
  <string name="lobby_join_room_hint">Enter a code a friend gave you.</string>
  <!-- Shown when the player is seated at a room; %1$s is the room code. -->
  <string name="lobby_in_room">In room %1$s</string>
  <string name="lobby_leave_room">Leave room</string>

  <!-- The join-by-code dialog (native; spec 01-screens.md forbids prompt()). -->
