<?xml version="1.0" encoding="utf-8"?>
<!--
  Native v1's string resources (S12 lobby entries + S15 Real Lobby + S16
  Room, and — since S41 — every older screen's text). This file is where a
  screen's text lives so the values-ar/ sibling translates the whole app
  without touching Kotlin. Tier and personality labels are deliberately absent here —
  they come from the engine enums' own displayName / blurb, so a
  translation of the characters lands with the engine, not duplicated in
  resources.
-->
<resources>
  <!-- S24: the manifest label reads this (was hardcoded). Proper noun, never translated. -->
  <string name="app_name" translatable="false">Made</string>

  <string name="choose_level_title">Choose Level</string>
