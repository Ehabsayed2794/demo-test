# Copy to native/keystore-release.properties (gitignored) and point it at
# the production keystore. NEVER commit the keystore itself (*.jks /
# *.keystore under native/ are gitignored) and never commit this filled-in
# file — CI injects these from repository secrets.
#
# Paths are resolved relative to native/, so an absolute path is safest:
#   storeFile=/absolute/path/to/estemshan-release.jks
#
# Without this file, ./gradlew :app:assembleRelease signs with AGP's debug
# keystore so the task always produces an installable APK — that is a local
# convenience, not a publishable artifact.

storeFile=
storePassword=
keyAlias=
keyPassword=
