{
  "name": "estemshan-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:hosting": "tsc -b && vite build --base=/estemshan/ && node scripts/build-hosting.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node scripts/run-tests.mjs",
    "test:ci": "firebase emulators:exec --project demo-test-ci --only firestore,auth \"node scripts/run-tests.mjs\""
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "firebase-tools": "^13.35.1",
    "oxlint": "^1.71.0",
    "playwright": "^1.62.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
