# P2-3: firestore.rules must check out LF everywhere — the deploy SHA
# guard and tests/rules-sha-pin.test.cjs hash its raw bytes
# (sha256sum semantics). A CRLF checkout would fail both with a
# misleading "mismatch".
firestore.rules text eol=lf

# Native Kotlin sources: LF everywhere (matches the toolchain matrix and
# avoids platform line-ending churn in review diffs).
*.kt text eol=lf
*.kts text eol=lf
*.gradle text eol=lf
*.pro text eol=lf
