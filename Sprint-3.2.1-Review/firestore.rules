rules_version = '2';

// Sprint 2.6 — Firebase Player Foundation. Extended in Sprint 3.2.1 with
// a rooms/{roomId} block (Critical Security & Schema Fix — see
// docs/implementation/RoomFoundation.md and
// docs/implementation/RoomSecurityFix.md). Everything else remains
// denied by default, per docs/architecture/SecurityArchitecture.md —
// collections not yet implemented (matches, inventory, shop,
// leaderboards, etc.) have no rules block here on purpose, and the
// explicit catch-all below denies them, matching the deny-all rule
// already live on this project before Sprint 2.6
// (see docs/architecture/ArchitectureDecisionLog.md).
//
// NOT YET DEPLOYED — this file is the reviewable artifact. To publish:
// Firebase Console → Firestore Database → Rules → paste this file's
// contents → Publish. See docs/implementation/FirebasePlayerFoundation.md
// and docs/implementation/RoomSecurityFix.md for the exact steps and
// what to verify afterward.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // A brand-new profile must exactly match PlayerService's approved
    // defaults (docs/architecture/FirestoreSchema.md) — a client cannot
    // create itself a profile with a head start on currency, rank, or
    // stats. This is the create-time half of the "protected fields"
    // requirement; onlyAllowedFieldsChanged() below is the update-time half.
    function isValidNewProfile() {
      let data = request.resource.data;
      return data.keys().hasOnly([
               'displayName', 'accountType', 'email', 'avatarInitial',
               'rank', 'rp', 'wins', 'streak', 'level',
               'coins', 'gems', 'createdAt', 'lastSeenAt',
               'currentRoomId', 'currentMatchId'
             ])
             && data.displayName is string && data.displayName.size() > 0
             && data.accountType in ['guest', 'full']
             && data.rank == 'Unranked'
             && data.rp == 0
             && data.wins == 0
             && data.streak == 0
             && data.level == 1
             && data.coins == 500
             && data.gems == 10
             && data.currentRoomId == null
             && data.currentMatchId == null;
    }

    // Protected fields (coins, gems, rank, rp, wins, streak, level,
    // accountType, email, createdAt) can NEVER change via a client update
    // — only these five may. See docs/architecture/SecurityArchitecture.md's
    // "protected fields" section and FirebasePlayerFoundation.md's honest
    // limitation note: this rule stops a client from EDITING those fields,
    // it does not (and structurally cannot, without Cloud Functions) verify
    // that a stat change reaching this collection via some OTHER path was
    // itself computed correctly — there is no other path yet, because
    // Sprint 2.6 implements no such path. This rule is what keeps it that
    // way until one is deliberately added.
    function onlyAllowedFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['displayName', 'avatarInitial', 'lastSeenAt', 'currentRoomId', 'currentMatchId']);
    }

    match /players/{uid} {
      allow get: if isOwner(uid);
      // Explicitly denied, not just omitted: a client must never be able
      // to query/enumerate the players collection to list other users'
      // private profiles.
      allow list: if false;
      allow create: if isOwner(uid) && isValidNewProfile();
      allow update: if isOwner(uid) && onlyAllowedFieldsChanged();
      allow delete: if false;
    }

    // ── rooms/{roomId} — Sprint 3.2.1 ──────────────────────────────────
    // Shape matches room-service.js's actual implementation (creator:
    // string, players: array of strings) — NOT the older, speculative
    // hostUid/seats[] draft. See docs/implementation/RoomSecurityFix.md
    // and docs/architecture/FirestoreSchema.md's updated rooms section.
    function isValidNewRoom() {
      let data = request.resource.data;
      return data.creator is string
             && data.creator == request.auth.uid
             && data.players is list
             && data.players.size() >= 1
             // The creator must be a member of their own room's player
             // list at creation time — matches createRoom()'s actual
             // behavior (players: [creator]) exactly.
             && data.creator in data.players
             && data.status is string;
    }

    // IMPORTANT — deviates from this sprint's literal instruction, on
    // purpose, with the reason recorded here (not silently): the brief
    // specified "allow update only if request.auth.uid is in the
    // EXISTING players array." Implemented literally, that rule makes
    // joinRoom() permanently impossible — a player joining is, by
    // definition, never already in the pre-write players array, so
    // every real join would be denied. That directly contradicts this
    // sprint's own stated goal ("unblock the Room functionality"), and
    // the required rule-simulation test below proves it concretely
    // rather than just asserting it.
    //
    // This checks EITHER the pre-write OR the post-write players array
    // instead. It still fully satisfies the stated security intent
    // ("prevents outsiders from modifying room state") — a user absent
    // from BOTH lists still cannot write anything to this document,
    // including adding themselves under someone else's identity or
    // editing a room they have no connection to at all. What it adds
    // over the literal spec is exactly the one case that must be
    // allowed for joining to work: a user who is about to add themself.
    function isExistingOrIncomingMember() {
      return request.auth.uid in resource.data.players
             || request.auth.uid in request.resource.data.players;
    }

    match /rooms/{roomId} {
      // Optimization intentionally skipped per the brief ("global auth
      // read is acceptable for MVP") — any signed-in user may read any
      // room, including via a list query.
      allow read: if request.auth != null;
      allow create: if request.auth != null && isValidNewRoom();
      allow update: if request.auth != null && isExistingOrIncomingMember();
      // Rooms are never deleted by design — leaveRoom() sets
      // status:"closed" on the last departure instead (see
      // room-service.js). No client-facing reason to allow delete.
      allow delete: if false;
    }

    // Deny-by-default for every collection outside this sprint's scope —
    // unchanged from the rule already live on this project.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
